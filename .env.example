# Tout est OPTIONNEL : le projet tourne sans aucune clé (mode mock + export CSV).
# Copier en .env (gitignoré) puis renseigner uniquement ce dont vous avez besoin.

# --- Couche IA générative (pme-radar draft --llm anthropic) ---
# Identifiants : clé API ci-dessous, ou profil créé par `ant auth login` (alors laisser vide).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Repli serveur si le modèle décline une demande (« default » ; « off » pour désactiver).
ANTHROPIC_FALLBACKS=default

# --- Export Google Sheets (optionnel) ---
# Chemin du fichier JSON d'un compte de service (jamais commité) et ID du classeur
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=

# --- Bonnes manières avec les API publiques ---
# User-Agent identifiant le projet (pas d'adresse personnelle requise)
PME_RADAR_USER_AGENT=pme-radar/0.1 (projet open source)

# --- Cache disque des API publiques ---
# Durée de validité en jours (défaut 6 : un run hebdomadaire repart de données fraîches).
# 0 = cache sans expiration (reproductibilité stricte d'un run).
PME_RADAR_CACHE_TTL_DAYS=6
